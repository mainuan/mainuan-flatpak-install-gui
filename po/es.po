msgid ""
"Provide a local .flatpakref file. Standalone IDs or URLs from the old "
"installer are not accepted."
msgstr ""
"Indique un archivo .flatpakref local. No se aceptan ID ni URL sueltos del "
"instalador antiguo."

#: qt/main.py:35
