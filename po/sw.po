#: qt/main.py:11
msgid "Mainuan Flatpak Installer — local .flatpakref file"
msgstr "Kisakinishi cha Flatpak cha Mainuan — faili la ndani la .flatpakref"

#: qt/main.py:12
msgid "a local .flatpakref file"
msgstr "faili la ndani la .flatpakref"

#: qt/main.py:14
msgid "visual demonstration, unable to install"
msgstr "onyesho la kuona, haliwezi kusakinisha"

#: qt/main.py:15
msgid "plain-text display name; does not change the identity"
msgstr "jina la kuonyeshwa kwa maandishi wazi; halibadilishi utambulisho"

#: qt/main.py:16
msgid "remove the exact reference, with graphical confirmation"
msgstr "ondoa rejeleo kamili, kwa uthibitisho wa kielelezo"

#: qt/main.py:17
msgid "user, system or system:ID; required for --remove"
msgstr "user, system au system:ID; inahitajika kwa --remove"

#: qt/main.py:22
msgid ""
"--fetch-dependencies and --do-install were discontinued: they were internal "
"Bash helpers. Open a .flatpakref file and use Install. No operation was "
"performed."
msgstr ""
"--fetch-dependencies na --do-install zimesitishwa: zilikuwa visaidizi vya "
"ndani vya Bash. Fungua faili la .flatpakref na utumie Sakinisha. Hakuna "
"operesheni iliyofanywa."

#: qt/main.py:27
msgid "Invalid destination: use user, system or system:ID."
msgstr "Mahali pa kusakinisha si sahihi: tumia user, system au system:ID."

#: qt/main.py:31
msgid ""
"--remove requires a .flatpakref file and --scope user|system|system:ID; the "
"identity comes from the file."
msgstr ""
"--remove inahitaji faili la .flatpakref na --scope user|system|system:ID; "
"utambulisho unatoka kwenye faili."

#: qt/main.py:33
msgid ""
"Provide a local .flatpakref file. Standalone IDs or URLs from the old "
"installer are not accepted."
msgstr ""
"Toa faili la ndani la .flatpakref. Vitambulisho au URL pekee kutoka "
"kisakinishi cha zamani havikubaliwi."

#: qt/main.py:35
msgid ""
"--demo is isolated: it does not accept a file, destination, removal or "
"overridden name."
msgstr ""
"--demo imetengwa: haikubali faili, mahali pa kusakinisha, kuondoa wala jina "
"lililobadilishwa."

#: qt/main.py:42
msgid ""
"Run the interface as a normal user. Flatpak/Polkit will ask for "
"authorization when needed."
msgstr ""
"Endesha kiolesura kama mtumiaji wa kawaida. Flatpak/Polkit itaomba idhini "
"inapohitajika."

#: qt/main.py:53
#, python-brace-format
