#: qt/main.py:12
msgid "a local .flatpakref file"
msgstr "ایک مقامی .flatpakref فائل"

#: qt/main.py:14
msgid "visual demonstration, unable to install"
msgstr "بصری نمائش، انسٹال کرنے سے قاصر"

#: qt/main.py:15
msgid "plain-text display name; does not change the identity"
msgstr "سادہ متن میں ظاہری نام؛ شناخت تبدیل نہیں کرتا"

#: qt/main.py:16
msgid "remove the exact reference, with graphical confirmation"
msgstr "گرافیکل تصدیق کے ساتھ عین حوالہ ہٹائیں"

#: qt/main.py:17
msgid "user, system or system:ID; required for --remove"
msgstr "user، system یا system:ID؛ --remove کے لیے لازمی"

# reviewed: Button name "Install" must be quoted; "انسٹال کریں استعمال کریں"
# read as two run-on imperatives
#: qt/main.py:22
msgid ""
"--fetch-dependencies and --do-install were discontinued: they were internal "
"Bash helpers. Open a .flatpakref file and use Install. No operation was "
"performed."
msgstr ""
"--fetch-dependencies اور --do-install بند کر دیے گئے: یہ اندرونی Bash مددگار "
"تھے۔ ایک .flatpakref فائل کھولیں اور “انسٹال کریں” استعمال کریں۔ کوئی "
"کارروائی نہیں کی گئی۔"

#: qt/main.py:27
msgid "Invalid destination: use user, system or system:ID."
msgstr "غلط منزل: user، system یا system:ID استعمال کریں۔"

#: qt/main.py:31
msgid ""
"--remove requires a .flatpakref file and --scope user|system|system:ID; the "
"identity comes from the file."
msgstr ""
"--remove کے لیے ایک .flatpakref فائل اور --scope user|system|system:ID درکار "
"ہیں؛ شناخت فائل سے لی جاتی ہے۔"

#: qt/main.py:33
msgid ""
"Provide a local .flatpakref file. Standalone IDs or URLs from the old "
"installer are not accepted."
msgstr ""
"ایک مقامی .flatpakref فائل فراہم کریں۔ پرانے انسٹالر کی الگ IDs یا URLs قبول "
"نہیں کیے جاتے۔"

#: qt/main.py:35
msgid ""
"--demo is isolated: it does not accept a file, destination, removal or "
"overridden name."
msgstr ""
"--demo الگ تھلگ ہے: یہ فائل، منزل، ہٹانا یا بدلا ہوا نام قبول نہیں کرتا۔"

#: qt/main.py:42
msgid ""
"Run the interface as a normal user. Flatpak/Polkit will ask for "
"authorization when needed."
msgstr ""
"انٹرفیس کو عام صارف کے طور پر چلائیں۔ ضرورت پڑنے پر Flatpak/Polkit اجازت طلب "
"کرے گا۔"

#: qt/main.py:53
#, python-brace-format
msgid "Qt dependency unavailable: {error}. See README.md."
msgstr "Qt انحصار دستیاب نہیں: {error}۔ README.md دیکھیں۔"

#: qt/metadata.py:24
msgid "The source must use HTTPS without credentials or fragments in the URL."
msgstr "ماخذ کو URL میں اسناد یا فریگمنٹس کے بغیر HTTPS استعمال کرنا چاہیے۔"

#: qt/metadata.py:30
msgid "Reference too large or with null bytes."
msgstr "حوالہ بہت بڑا ہے یا اس میں null بائٹس ہیں۔"

#: qt/metadata.py:37
msgid "Invalid reference group."
msgstr "غلط حوالہ گروپ۔"

#: qt/metadata.py:40
msgid "Multi-line fields are not accepted."
msgstr "کئی سطری فیلڈز قبول نہیں کی جاتیں۔"

#: qt/metadata.py:43
msgid "Invalid Flatpak reference."
msgstr "غلط Flatpak حوالہ۔"

#: qt/metadata.py:50
msgid "Invalid GPG key."
msgstr "غلط GPG کلید۔"

#: qt/metadata.py:64
msgid "not provided by the libflatpak proposal signal"
msgstr "libflatpak کے تجویزی سگنل نے فراہم نہیں کیا"

#: qt/metadata.py:66
msgid "absent — GPG signature disabled"
msgstr "موجود نہیں — GPG دستخط غیر فعال"

#: qt/metadata.py:67
#, python-brace-format
msgid ""
"Source: {url}\n"
"Suggested name: {name}\n"
"Descriptor: {descriptor}\n"
"SHA-256 of the provided key: {fingerprint}\n"
"HTTPS protects the transport; it does not guarantee that this source is "
"trustworthy. Adding the source changes the Flatpak configuration now. It may "
"remain even if the installation is cancelled."
msgstr ""
"ماخذ: {url}\n"
"تجویز کردہ نام: {name}\n"
"وضاحت نامہ: {descriptor}\n"
"فراہم کردہ کلید کا SHA-256: {fingerprint}\n"
"HTTPS ترسیل کو محفوظ کرتا ہے؛ یہ اس بات کی ضمانت نہیں دیتا کہ یہ ماخذ قابلِ "
"اعتماد ہے۔ ماخذ شامل کرنے سے Flatpak کی کنفیگریشن ابھی تبدیل ہو جاتی ہے۔ "
"انسٹالیشن منسوخ ہونے پر بھی یہ باقی رہ سکتا ہے۔"

