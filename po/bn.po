#: qt/flatpak_backend.py:319
msgid "(source unavailable)"
msgstr "(উৎস উপলব্ধ নয়)"

#: qt/flatpak_backend.py:328
msgid "In progress…"
msgstr "চলছে…"

#: qt/flatpak_backend.py:335
msgid "The transaction was not completed."
msgstr "ট্রানজ্যাকশনটি সম্পন্ন হয়নি।"

#: qt/flatpak_backend.py:340
msgid "The reference has no confirmed deployment."
msgstr "রেফারেন্সটির কোনো নিশ্চিত ডিপ্লয়মেন্ট নেই।"

#: qt/flatpak_backend.py:342
msgid "The installed source differs from the transaction source."
msgstr "ইনস্টল করা উৎসটি ট্রানজ্যাকশনের উৎস থেকে আলাদা।"

#: qt/flatpak_backend.py:351
msgid "The selected reference changed."
msgstr "নির্বাচিত রেফারেন্সটি পরিবর্তিত হয়েছে।"

#: qt/flatpak_backend.py:376
msgid "The reference is still installed in the selected destination."
msgstr "রেফারেন্সটি এখনও নির্বাচিত গন্তব্যে ইনস্টল করা আছে।"

#: qt/flatpak_backend.py:387
msgid "Ambiguous or unavailable system installation."
msgstr "দ্ব্যর্থক বা অনুপলব্ধ সিস্টেম ইনস্টলেশন।"

#: qt/flatpak_backend.py:390
msgid "The path of the selected installation changed."
msgstr "নির্বাচিত ইনস্টলেশনের পাথ পরিবর্তিত হয়েছে।"

#: qt/flatpak_backend.py:399
msgid "Flatpak did not confirm opening the application."
msgstr "Flatpak অ্যাপ্লিকেশন খোলার বিষয়টি নিশ্চিত করেনি।"

#: qt/flatpak_backend.py:413 qt/flatpak_backend.py:421
msgid "Authorization was denied or cancelled."
msgstr "অনুমোদন প্রত্যাখ্যান বা বাতিল করা হয়েছে।"

#: qt/flatpak_backend.py:418
msgid "Could not access the source. Check the connection and try again."
msgstr "উৎসে প্রবেশ করা যায়নি। সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।"

#: qt/flatpak_backend.py:420
msgid "Permission denied for this operation."
msgstr "এই প্রক্রিয়ার অনুমতি প্রত্যাখ্যান করা হয়েছে।"

#: qt/flatpak_backend.py:422
msgid "Could not authenticate with the source."
msgstr "উৎসের সাথে প্রমাণীকরণ করা যায়নি।"

#: qt/flatpak_backend.py:423
msgid "The source is not available."
msgstr "উৎসটি উপলব্ধ নয়।"

#: qt/flatpak_backend.py:424
msgid "The required components are not available."
msgstr "প্রয়োজনীয় উপাদানগুলো উপলব্ধ নয়।"

#: qt/flatpak_backend.py:425
msgid "The application was already installed by another process. Try again."
msgstr "অ্যাপ্লিকেশনটি অন্য একটি প্রক্রিয়া ইতিমধ্যে ইনস্টল করেছে। আবার চেষ্টা করুন।"

#: qt/flatpak_backend.py:426
msgid "There is an installation from another source in this destination."
msgstr "এই গন্তব্যে অন্য একটি উৎস থেকে করা ইনস্টলেশন রয়েছে।"

#: qt/flatpak_backend.py:427
msgid "The Flatpak reference is invalid."
msgstr "Flatpak রেফারেন্সটি অবৈধ।"

#: qt/flatpak_backend.py:428
msgid "There is not enough space to install."
msgstr "ইনস্টল করার জন্য পর্যাপ্ত জায়গা নেই।"

#: qt/flatpak_backend.py:432
msgid "Another installation is in progress. Try again."
msgstr "আরেকটি ইনস্টলেশন চলছে। আবার চেষ্টা করুন।"

#: qt/flatpak_backend.py:434
msgid "Could not access the source. Check the connection and the details."
msgstr "উৎসে প্রবেশ করা যায়নি। সংযোগ ও বিস্তারিত তথ্য পরীক্ষা করুন।"

#: qt/flatpak_backend.py:435
msgid "Could not complete the operation. See the details."
msgstr "প্রক্রিয়াটি সম্পন্ন করা যায়নি। বিস্তারিত দেখুন।"

#: qt/main.py:11
msgid "Mainuan Flatpak Installer — local .flatpakref file"
msgstr "Mainuan Flatpak ইনস্টলার — স্থানীয় .flatpakref ফাইল"

#: qt/main.py:12
msgid "a local .flatpakref file"
msgstr "একটি স্থানীয় .flatpakref ফাইল"

#: qt/main.py:14
msgid "visual demonstration, unable to install"
msgstr "দৃশ্যমান ডেমো, ইনস্টল করতে পারে না"

#: qt/main.py:15
msgid "plain-text display name; does not change the identity"
msgstr "সাধারণ টেক্সটে প্রদর্শিত নাম; পরিচয় পরিবর্তন করে না"

# reviewed: texto de --help descreve a opção; usar substantivo verbal como nas
# entradas 22-23
#: qt/main.py:16
msgid "remove the exact reference, with graphical confirmation"
msgstr "গ্রাফিক্যাল নিশ্চিতকরণসহ নির্দিষ্ট রেফারেন্সটি সরানো"

#: qt/main.py:17
msgid "user, system or system:ID; required for --remove"
msgstr "user, system অথবা system:ID; --remove-এর জন্য আবশ্যক"

#: qt/main.py:22
msgid ""
"--fetch-dependencies and --do-install were discontinued: they were internal "
"Bash helpers. Open a .flatpakref file and use Install. No operation was "
"performed."
msgstr ""
"--fetch-dependencies ও --do-install বন্ধ করে দেওয়া হয়েছে: এগুলো অভ্যন্তরীণ Bash "
"সহায়ক ছিল। একটি .flatpakref ফাইল খুলে ইনস্টল ব্যবহার করুন। কোনো প্রক্রিয়া সম্পাদন "
"করা হয়নি।"

#: qt/main.py:27
msgid "Invalid destination: use user, system or system:ID."
msgstr "অবৈধ গন্তব্য: user, system অথবা system:ID ব্যবহার করুন।"

#: qt/main.py:31
msgid ""
"--remove requires a .flatpakref file and --scope user|system|system:ID; the "
"identity comes from the file."
msgstr ""
"--remove-এর জন্য একটি .flatpakref ফাইল এবং --scope user|system|system:ID "
"প্রয়োজন; পরিচয় ফাইল থেকে নেওয়া হয়।"

#: qt/main.py:33
msgid ""
"Provide a local .flatpakref file. Standalone IDs or URLs from the old "
"installer are not accepted."
msgstr ""
"একটি স্থানীয় .flatpakref ফাইল দিন। পুরোনো ইনস্টলারের আলাদা ID বা URL গ্রহণ করা "
"হয় না।"

#: qt/main.py:35
msgid ""
"--demo is isolated: it does not accept a file, destination, removal or "
"overridden name."
msgstr ""
"--demo বিচ্ছিন্ন: এটি কোনো ফাইল, গন্তব্য, অপসারণ বা পরিবর্তিত নাম গ্রহণ করে না।"

#: qt/main.py:42
msgid ""
"Run the interface as a normal user. Flatpak/Polkit will ask for "
"authorization when needed."
msgstr ""
"ইন্টারফেসটি সাধারণ ব্যবহারকারী হিসেবে চালান। প্রয়োজন হলে Flatpak/Polkit অনুমোদন "
"চাইবে।"

#: qt/main.py:53
