"Źródło musi używać HTTPS bez danych uwierzytelniających ani fragmentów w "
"adresie URL."

#: qt/metadata.py:30
msgid "Reference too large or with null bytes."
msgstr "Odniesienie jest zbyt duże lub zawiera bajty zerowe."

#: qt/metadata.py:37
msgid "Invalid reference group."
msgstr "Nieprawidłowa grupa odniesienia."

#: qt/metadata.py:40
msgid "Multi-line fields are not accepted."
msgstr "Pola wielowierszowe nie są przyjmowane."

#: qt/metadata.py:43
msgid "Invalid Flatpak reference."
