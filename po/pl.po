#: qt/metadata.py:67
#, python-brace-format
msgid ""
"Source: {url}\n"
"Suggested name: {name}\n"
"Descriptor: {descriptor}\n"
"SHA-256 of the provided key: {fingerprint}\n"
"HTTPS protects the transport; it does not guarantee that this source is "
"trustworthy. Adding the source changes the Flatpak configuration now. It may "
"remain even if the installation is cancelled."
msgstr ""
"Źródło: {url}\n"
"Proponowana nazwa: {name}\n"
"Deskryptor: {descriptor}\n"
"SHA-256 dostarczonego klucza: {fingerprint}\n"
"HTTPS chroni przesyłanie; nie gwarantuje, że to źródło jest godne zaufania. "
"Dodanie źródła od razu zmienia konfigurację Flatpak. Może ono pozostać nawet "
"po anulowaniu wgrywania."

#: qt/metadata.py:72
msgid "local file"
msgstr "plik lokalny"

#: qt/metadata.py:109
msgid "Reference version not supported yet."
msgstr "Wersja odniesienia nie jest jeszcze obsługiwana."

#: qt/metadata.py:115
