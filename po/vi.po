#: qt/metadata.py:67
#, python-brace-format
msgid ""
"Source: {url}\n"
"Suggested name: {name}\n"
"Descriptor: {descriptor}\n"
"SHA-256 of the provided key: {fingerprint}\n"
"HTTPS protects the transport; it does not guarantee that this source is "
"trustworthy. Adding the source changes the Flatpak configuration now. It may "
"remain even if the installation is cancelled."
msgstr ""
"Nguồn: {url}\n"
"Tên đề xuất: {name}\n"
"Tệp mô tả: {descriptor}\n"
"SHA-256 của khoá được cung cấp: {fingerprint}\n"
"HTTPS bảo vệ đường truyền; nó không đảm bảo nguồn này đáng tin cậy. Việc "
"thêm nguồn sẽ thay đổi cấu hình Flatpak ngay bây giờ. Nguồn có thể vẫn còn "
"ngay cả khi việc cài đặt bị huỷ."

